generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Employee {
  id         Int      @id @default(autoincrement())
  position     String
  hireDate     DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  teamId     Int?
}




