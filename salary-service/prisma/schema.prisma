generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model Salary {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  baseSalary    Float
  totalHours    Float
  overtimeHours Float
  totalSalary   Float
  createdAt     DateTime  @default(now())
  updatedAt   DateTime @updatedAt

}
